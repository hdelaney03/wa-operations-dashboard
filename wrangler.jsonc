{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wa-operations-dashboard",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-27",
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ALLOWED_ORIGIN": "https://hdelaney03.github.io",
    "EMERGENCY_WA_RSS_URL": ""
  },
  "durable_objects": {
    "bindings": [
      { "name": "FEED_COORDINATOR", "class_name": "FeedCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FeedCoordinator"] }
  ]
}
